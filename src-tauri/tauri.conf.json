{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orb Sees All",
  "version": "0.3.0",
  "identifier": "com.orb.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orb Sees All",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5M0I4QzQ5OTgxQzVDMzQKUldRMFhCeVlTWXc3Q1VrU0tVUThGUmk0SHpqNjI2akM0UUVEVEVxUW9Ec2tVUEhlTkNGTlJDQWMK",
      "endpoints": [
        "https://github.com/jonathantcallahan/orb-sees-all/releases/latest/download/latest.json"
      ]
    }
  }
}
